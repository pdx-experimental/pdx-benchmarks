# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Python, shell, markdown
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.toml text eol=lf
*.ipynb text eol=lf

# Preserve exact bytes of hash-bound evidence exports
slm-task-governance/data/results_formal_candidate/** -text

# Timestamp-bound protocol snapshots retain original bytes
slm-task-governance/evidence/** -text

# Historical evidence retains its original CRLF bytes.
slm-task-governance/evidence/** whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
